<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_vertical">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_title"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_title_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Artist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_artist"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_artist_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Album -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_album"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_album_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Genre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_genre"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_genre_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Year -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_year"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_year_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Format -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_format"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_format_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Sample Rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_sample_rate"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_sample_rate_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bit Rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_bitrate"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_bitrate_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- BPM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/tag_label_bpm"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            app:textFontWeight="600" />
        <TextView
            android:id="@+id/info_bpm_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?colorOnSurface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
