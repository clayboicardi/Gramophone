<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header: Title + Enable switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/equalizer"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/eq_enable_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Preset dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/preset_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/preset">

            <AutoCompleteTextView
                android:id="@+id/preset_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Unsupported message (hidden by default) -->
        <TextView
            android:id="@+id/eq_unsupported_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="48dp"
            android:text="@string/eq_not_supported"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <!-- Band sliders container (populated dynamically) -->
        <HorizontalScrollView
            android:id="@+id/bands_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bands_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>

        <!-- Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp" />

        <!-- Bass Boost -->
        <LinearLayout
            android:id="@+id/bass_boost_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bass_boost"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/bass_boost_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1000"
                android:stepSize="50" />
        </LinearLayout>

        <!-- Virtualizer -->
        <LinearLayout
            android:id="@+id/virtualizer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/virtualizer"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/virtualizer_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1000"
                android:stepSize="50" />
        </LinearLayout>

        <!-- Reset button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/reset_to_flat" />

        <!-- Switch to Advanced EQ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/switch_to_advanced_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/eq_switch_to_advanced" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
